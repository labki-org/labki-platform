{
    "require": {
        "mediawiki/semantic-media-wiki": "~7.3",
        "mediawiki/semantic-result-formats": "~6.0",
        "mediawiki/page-forms": "^6.0.11",
        "mediawiki/maps": "~15.0",
        "mediawiki/semantic-extra-special-properties": "~5.0",
        "mediawiki/semantic-compound-queries": "~4.0",
        "wikimedia/composer-merge-plugin": "^2.0",
        "mediawiki/mermaid": "~6.0.2",
        "scssphp/scssphp": "~1.11"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "extra": {
        "installer-paths": {
            "extensions/{$name}/": [
                "type:mediawiki-extension"
            ],
            "skins/{$name}/": [
                "type:mediawiki-skin"
            ]
        },
        "merge-plugin": {
            "include": [
                "extensions/*/composer.json"
            ],
            "recurse": true,
            "replace": false,
            "merge-dev": false
        }
    }
}
